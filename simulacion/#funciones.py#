def posibles_puertas(width, height): # para main_iterar.py
    """
    Retorna una lista de tuplas (x, y) que representan TODAS
    las posiciones posibles del borde de una habitación de
    dimensiones width x height.

    El borde corresponde a las filas y columnas extremas.
    """
    for x in range(1, width-1):
        yield (x, 0)
    for x in range(1, width-1):
        yield (x, height-1)
    for y in range(1, height-1):
        yield (0, y)
    for y in range(1, height-1):
        yield (width-1, y)
 
def generar_combinaciones_puertas(width, height, k): # para main_iterar.py
    """
    Retorna todas las combinaciones posibles de k puertas.
    """
    
    return combinations(posibles_puertas(width, height), k)

def cargar_escenario(): # común
    """
    Pide al usuario seleccionar uno de los escenarios disponibles
    y retorna el módulo correspondiente.
    """
    import importlib

    escenarios_disponibles = {
        "1": "escenario_base",
        "2": "avion",
        "3": "sala_de_clases",
        "4": "escenario_base_v2_cerca",
        "5": "escenario_base_v1_cerca"
    }

    print("--- Escenarios disponibles ---")
    print("1) Escenario base")
    print("2) Avión")
    print("3) Sala de clases")
    print("4) Los rápidos cerca de la puerta")
    print("5) Los lentos cerca de la puerta")
    print("------------------------------")

    eleccion = input("Elige un escenario (1-5): ").strip()

    if eleccion not in escenarios_disponibles:
        raise ValueError("Escenario no válido.")

    nombre_modulo = escenarios_disponibles[eleccion]

    # para la importación desde el paquete escenarios
    modulo = importlib.import_module(f"escenarios.{nombre_modulo}")

    print(f"\nEscenario cargado: {nombre_modulo}\n")
    return modulo

def mostrar_matriz(campo, agentes):
    """Función para visualizar la simulación en la terminal"""
    os.system("clear")  
    for y in range(campo.height):
        fila = ""
        for x in range(campo.width):
            # Buscamos si hay un agente ACTIVO en esta coordenada (x, y)
            agente_aqui = next((a for a in agentes if a.x == x and a.y == y and a.activo), None)
            
            if agente_aqui is not None:
                # Si existe, pintamos su ID. 
                fila += f"{agente_aqui.id}" 
            elif campo.valores[y, x] == 500:
                fila += "█ "
            elif campo.valores[y, x] == 0:
                fila += "⎯ "
            else:
                fila += ". "
        print(fila)
    print(f"Agentes activos: {sum(a.activo for a in agentes)}\n")

def guardar_frame(campo, agentes, paso): # para guardar data del simulador desde main_visual.py
    """Función para guardar cada frame como imagen"""
    lines = []
    for y in range(campo.height):
        fila = ""
        for x in range(campo.width):
            if any(a.x == x and a.y == y and a.activo for a in agentes):
                fila += "A"
            elif campo.valores[y, x] == 500:
                fila += "█ "
            elif campo.valores[y, x] == 0:
                fila += "⎯ "
            else:
                fila += ". "
        lines.append(fila)
    font = ImageFont.truetype("DejaVuSansMono.ttf", 16)

    line_height = 18
    max_width = max(len(line) for line in lines)
    width = max_width * 11 + 20
   

    img = Image.new("RGB", (width, campo.height * line_height), "white")
    draw = ImageDraw.Draw(img)

    for i, linea in enumerate(lines):
        draw.text((10, i * line_height), linea, font=font, fill="black")

