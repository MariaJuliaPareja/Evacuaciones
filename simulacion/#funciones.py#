def correr_simulacion(esc, puertas): #función para main_iterado.py
    """
    Corre la simulación sin visualización. Calcula tiempo de evacuación.
    """
    campo = Floor_field(esc.width, esc.height, puertas, esc.obstaculos)

    agentes = [Agente(x, y, campo) for (x, y) in esc.agentes]

    pasos = 0

    while any(a.activo for a in agentes):
        mover_agentes(agentes)
        pasos += 1

    return pasos
