'''
las primeras funciones seran para tener todas las posiciones posibles de las puertas y que se itere la simulacion para todas estas 

'''
# simulacion/funciones.py
from itertools import combinations
import importlib

def posibles_puertas(width, height):
    """
    Retorna una lista de tuplas (x, y) que representan TODAS
    las posiciones posibles del borde de una habitación de
    dimensiones width x height.

    El borde corresponde a las filas y columnas extremas.
    """
    for x in range(1, width-1):
        yield (x, 0)
    for x in range(1, width-1):
        yield (x, height-1)
    for y in range(1, height-1):
        yield (0, y)
    for y in range(1, height-1):
        yield (width-1, y)
 
def generar_combinaciones_puertas(width, height, k):
    """
    Retorna todas las combinaciones posibles de k puertas.
    """
    
    return combinations(posibles_puertas(width, height), k)

def cargar_escenario():
    """
    Pide al usuario seleccionar uno de los escenarios disponibles
    y retorna el módulo correspondiente.
    """
    import importlib

    escenarios_disponibles = {
        "1": "escenario_base",
        "2": "avion",
        "3": "sala_de_clases",
    }

    print("--- Escenarios disponibles ---")
    print("1) Escenario base")
    print("2) Avión")
    print("3) Sala de clases")
    print("------------------------------")

    eleccion = input("Elige un escenario (1-3): ").strip()

    if eleccion not in escenarios_disponibles:
        raise ValueError("Escenario no válido.")

    nombre_modulo = escenarios_disponibles[eleccion]

    # para la importación desde el paquete escenarios
    modulo = importlib.import_module(f"escenarios.{nombre_modulo}")

    print(f"\nEscenario cargado: {nombre_modulo}\n")
    return modulo
